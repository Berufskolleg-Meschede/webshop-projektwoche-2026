# Copy to .env (never commit .env; it is git-ignored).
# NOTE: all VITE_* values are embedded in the client bundle and visible to every visitor.

# Base URL of the ERP backend.
VITE_API_BASE_URL=http://localhost:8000

# Optional bearer token for the ERP backend. Leave empty to use the API key
# that the app fetches on startup.
VITE_API_AUTH_TOKEN=

# Origin encoded in the role QR codes (must be reachable from students' phones).
# Defaults to the address the dashboard was opened with.
# VITE_PUBLIC_BASE_URL=http://<host>:51020

# Simulation server (own Node process, no ERP). Defaults to the app's own origin;
# in dev Vite proxies /simulation to `npm run server` (port 3001).
# Only set this for a separate origin; then start the server with
# CORS_ORIGINS=<frontend origin> (comma separated, e.g. http://localhost:5173).
# VITE_SIMULATION_API_BASE_URL=http://localhost:3001

# Commit SHA shown in the build info. Set by CI (docker build arg); leave empty locally.
VITE_COMMIT_SHA=

# Deployment (Synology NAS, read by docker-compose.yml, not by Vite):
# Hostname Traefik routes to the frontend container.
# WEBSHOP_HOST=webshop.local
